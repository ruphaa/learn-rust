  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The next learning or project action.",
      "html": "<a class=\"ds-primary\" href=\"#/projects\">Explore projects</a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:12px 20px;min-height:46px;border-radius:9px;color:#343454;background:#f18489;text-decoration:none;font:600 .9rem/1.7 var(--sans,'DM Sans Variable',sans-serif)}.ds-primary:hover{background:#ee979c}.ds-primary:focus-visible{outline:3px solid var(--sage,#454b7c);outline-offset:3px}"
    },
    {
      "name": "Lesson completion",
      "kind": "button",
      "refersTo": "button-complete",
      "description": "Record a lesson; the completed state uses a leaf surface and sage text.",
      "html": "<button class=\"ds-complete\" type=\"button\">Mark lesson complete</button>",
      "css": ".ds-complete{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 16px;border:0;border-radius:9px;background:#f18489;color:#343454;font:600 .85rem/1.7 var(--sans,'DM Sans Variable',sans-serif);cursor:pointer}.ds-complete[aria-pressed=true]{background:var(--leaf,#ffffff);color:var(--sage,#454b7c)}.ds-complete:focus-visible{outline:3px solid var(--sage,#454b7c);outline-offset:3px}"
    },
    {
      "name": "Icon button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "Theme and mobile navigation controls.",
      "html": "<button class=\"ds-icon\" type=\"button\" aria-label=\"Open course navigation\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg></button>",
      "css": ".ds-icon{width:44px;height:44px;display:grid;place-items:center;background:var(--leaf,#ffffff);color:var(--ink,#42445f);border:1px solid var(--line,#dce1ed);border-radius:10px;cursor:pointer}.ds-icon:hover{background:var(--mint,#d9f0f7)}.ds-icon:focus-visible{outline:3px solid var(--sage,#454b7c);outline-offset:3px}"
    },
    {
      "name": "Project search",
      "kind": "input",
      "refersTo": "project-search",
      "description": "Filter projects by name and concept.",
      "html": "<input class=\"ds-search\" type=\"search\" aria-label=\"Search projects\" placeholder=\"Find a project…\">",
      "css": ".ds-search{border:1px solid var(--line,#dce1ed);border-radius:8px;padding:10px 12px;background:var(--leaf,#ffffff);color:var(--ink,#42445f);width:185px;font:.85rem/1.7 var(--sans,'DM Sans Variable',sans-serif);caret-color:var(--sage,#454b7c)}.ds-search::placeholder{color:var(--faint,#60657e);opacity:1}.ds-search:focus-visible{outline:3px solid var(--sage,#454b7c);outline-offset:3px}@media(max-width:760px){.ds-search{width:100%}}"
    },
    {
      "name": "Lesson navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "A selected curriculum row with a source index.",
      "html": "<a class=\"ds-nav\" href=\"#/lesson/why-rust\" aria-current=\"page\"><i>1</i><span>Why Rust?</span></a>",
      "css": ".ds-nav{display:grid;grid-template-columns:22px 1fr;align-items:center;gap:8px;min-height:43px;padding:9px 10px;border-radius:8px;text-decoration:none;color:var(--muted,#555a75);font:.82rem/1.45 var(--sans,'DM Sans Variable',sans-serif)}.ds-nav i{display:grid;place-items:center;height:20px;width:20px;font:normal .7rem var(--mono,'IBM Plex Mono',monospace);color:var(--faint,#60657e)}.ds-nav[aria-current]{background:var(--mint,#d9f0f7);color:var(--sage,#454b7c);font-weight:650}.ds-nav[aria-current] i{background:var(--sage,#454b7c);color:var(--leaf,#ffffff);border-radius:5px}.ds-nav:hover{background:var(--leaf,#ffffff)}.ds-nav:focus-visible{outline:3px solid var(--sage,#454b7c);outline-offset:3px}"
    },
    {
      "name": "Learning level",
      "kind": "chip",
      "refersTo": "level-badge",
      "description": "Static level labels retain their names alongside pastel color.",
      "html": "<span class=\"ds-badge\">Beginner</span>",
      "css": ".ds-badge{display:inline-block;border-radius:6px;padding:4px 9px;font:650 .75rem/1.7 var(--sans,'DM Sans Variable',sans-serif);background:var(--mint,#d9f0f7);color:var(--ink-strong,#44446e)}.ds-badge[data-level=intermediate]{background:var(--yellow,#f0f1f7)}.ds-badge[data-level=advanced]{background:var(--lavender,#e3eafa)}.ds-badge[data-level=production]{background:var(--peach,#fce3e5)}"
    },
    {
      "name": "Project card",
      "kind": "card",
      "refersTo": "project-card",
      "description": "An actionable guide summary with room for concepts and milestones.",
      "html": "<a class=\"ds-card\" href=\"#/project/temperature\"><h3>Temperature converter</h3><p>Start with a tiny program that works.</p><span>Explore the guide →</span></a>",
      "css": ".ds-card{display:flex;flex-direction:column;border:1px solid var(--line,#dce1ed);background:var(--leaf,#ffffff);border-radius:14px;padding:24px;text-decoration:none;color:var(--ink,#42445f);font:1rem/1.7 var(--sans,'DM Sans Variable',sans-serif);transition:border-color 160ms ease,background 160ms ease}.ds-card:hover{border-color:var(--sage,#454b7c);background:color-mix(in srgb,var(--mint,#d9f0f7) 30%,var(--leaf,#ffffff))}.ds-card h3{margin:19px 0 10px;font:400 1.4rem/1.25 var(--heading,'Bree Serif',Georgia,serif);letter-spacing:0;color:var(--ink-strong,#44446e)}.ds-card p{margin:0 0 20px;color:var(--muted,#555a75);font-size:.91rem}.ds-card>span{border-top:1px solid var(--line,#dce1ed);padding-top:15px;margin-top:18px;color:var(--sage,#454b7c);font-size:.77rem}.ds-card:focus-visible{outline:3px solid var(--sage,#454b7c);outline-offset:3px}@media(max-width:760px){.ds-card{padding:22px}.ds-card h3{font-size:1.3rem}}@media(prefers-reduced-motion:reduce){.ds-card{transition:none}}"
    },
    {
      "name": "Answer choice",
      "kind": "button",
      "refersTo": "answer-option",
      "description": "A prediction choice with semantic and visible result states.",
      "html": "<button class=\"ds-answer\" type=\"button\"><span>B</span>moved</button>",
      "css": ".ds-answer{min-height:62px;display:flex;align-items:center;gap:12px;border:1px solid var(--line-strong,#9babc8);border-radius:10px;padding:12px 16px;text-align:left;background:var(--leaf,#ffffff);color:var(--ink,#42445f);font:.9rem/1.7 var(--sans,'DM Sans Variable',sans-serif);cursor:pointer}.ds-answer>span{color:var(--faint,#60657e);font:.8rem var(--mono,'IBM Plex Mono',monospace)}.ds-answer:hover{background:var(--mint,#d9f0f7)}.ds-answer[data-result=correct]{background:var(--mint,#d9f0f7);border-color:var(--sage,#454b7c)}.ds-answer[data-result=incorrect]{background:var(--peach,#fce3e5);border-color:var(--rust,#a63e51)}.ds-answer:focus-visible{outline:3px solid var(--sage,#454b7c);outline-offset:3px}"
    },
    {
      "name": "Compiler note",
      "kind": "card",
      "refersTo": "field-note",
      "description": "A quiet yellow explanation beside the lesson.",
      "html": "<aside class=\"ds-note\"><span>Compiler note</span><p>Ownership tells Rust when a value can be cleaned up.</p></aside>",
      "css": ".ds-note{background:var(--yellow,#f0f1f7);color:var(--ink,#42445f);padding:20px;border-radius:12px;margin:24px 0;font:1rem/1.7 var(--sans,'DM Sans Variable',sans-serif)}.ds-note>span{font-weight:650;font-size:.85rem}.ds-note p{margin:7px 0 0}"
    },
    {
      "name": "Code workbench",
      "kind": "custom",
      "refersTo": "code-workbench",
      "description": "A stable dark example surface; the action reveals an expected result.",
      "html": "<section class=\"ds-code\"><header><span>Example</span><button type=\"button\">Show result</button></header><pre tabindex=\"0\"><code>let note = String::from(\"hello\");\nlet moved = note;</code></pre><footer>Predict what happens, then reveal the result.</footer></section>",
      "css": ".ds-code{background:#30314e;color:#f1f3ff;border-radius:12px;overflow:hidden;font:.8rem/1.7 var(--sans,'DM Sans Variable',sans-serif)}.ds-code header{display:flex;align-items:center;justify-content:space-between;padding-left:16px;border-bottom:1px solid #636a91}.ds-code button{min-height:46px;border:0;background:#b5e2ee;color:#343454;padding:10px 12px;font:.8rem/1.7 var(--sans,'DM Sans Variable',sans-serif);cursor:pointer}.ds-code pre{padding:22px;margin:0;overflow-x:auto;font:.85rem/1.8 var(--mono,'IBM Plex Mono',monospace);tab-size:4}.ds-code code{font:inherit}.ds-code footer{padding:14px 18px;border-top:1px solid #636a91;color:#c5cde6}.ds-code button:focus-visible{outline:3px solid var(--sage,#454b7c);outline-offset:3px}.ds-code pre:focus-visible{outline:3px solid var(--sage,#454b7c);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Sky-blue Field Notes",
    "overview": "The supplied medicine-presentation reference sets the theme: white ground, pale sky blue, coral, periwinkle, and deep indigo lettering. Bree Serif gives headings the same rounded slab-serif character; DM Sans keeps navigation and reading copy clear. This is a visual match in spirit, not a claim that the reference font was identified exactly. Layout, Rust content, and behavior remain unchanged.",
    "keyCharacteristics": [
      "White canvas with sky-blue learning surfaces and coral primary actions.",
      "Indigo serif headings, clear sans-serif body copy, and monospace code.",
      "Existing rounded controls, responsive navigation, lessons, and project guides."
    ],
    "rules": [],
    "dos": [
      "Do keep Bree Serif at its real 400 weight with font synthesis disabled.",
      "Do use dark indigo text on pale accents and coral actions.",
      "Do preserve the learning content, route behavior, and visible Projects navigation."
    ],
    "donts": [
      "Don’t use white text on coral buttons; the dark action text is intentional.",
      "Don’t restore the superseded cream-and-sage palette or Nunito headings.",
      "Don’t infer medical illustrations or copy from a palette-and-type reference."
    ]
  }
}
